{
  "name": "iot-blockchain-security",
  "version": "2.0.0",
  "description": "Securing communication between IoT devices with an Ethereum device registry, attestations and signed, replay-protected messaging.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "gas": "REPORT_GAS=true hardhat test",
    "lint": "solhint 'contracts/**/*.sol'",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "simulate": "hardhat run scripts/simulate.js"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.28.0",
    "solhint": "^6.0.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0"
  }
}
